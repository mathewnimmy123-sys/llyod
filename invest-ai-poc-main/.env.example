# Copy to invest_advisor/.env  (this is the folder `adk web` reads). NEVER commit the real file.
GOOGLE_API_KEY=your_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=FALSE
INVEST_AI_MODEL=gemini-2.5-flash
# Optional
#INVEST_AI_MODEL=gemini-2.5-flash
# LOCAL_AUDIT_LOG=true
# ENABLE_CLOUD_LOGGING=false      # true needs GCP credentials (gcloud auth application-default login)
# GOOGLE_CLOUD_PROJECT=your-gcp-project
